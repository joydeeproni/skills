{
  "//": "Merge this into .claude/settings.json to nudge the assistant after each git commit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-post-tool-commit.sh\"",
            "statusMessage": "Updating UX case study…"
          }
        ]
      }
    ]
  }
}
