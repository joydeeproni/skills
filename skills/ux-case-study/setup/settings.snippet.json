{
  "//": "Merge into .claude/settings.json (hook) and .claude/settings.local.json (permissions). The permissions.allow rules keep the skill from prompting on its routine, safe operations — read-only git, the two Notion calls, and the deterministic bookkeeping commands. Notion writes go to YOUR page; drop notion-update-page from allow if you'd rather confirm each write.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-post-tool-commit.sh\"",
            "statusMessage": "Updating UX case study…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(cat .claude/casestudy/pending-commits.txt)",
      "Bash(cat .claude/casestudy/processed-commits.txt)",
      "Bash(cat .claude/casestudy/pending-commits.txt >> .claude/casestudy/processed-commits.txt)",
      "Bash(: > .claude/casestudy/pending-commits.txt)",
      "mcp__claude_ai_Notion__notion-fetch",
      "mcp__claude_ai_Notion__notion-update-page"
    ]
  }
}
